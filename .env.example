GEMINI_API_KEY=your-gemini-key-here
# Optional — additional Gemini keys to rotate through automatically when the
# current one hits a rate limit or expires (config.py's RotatingGeminiClient).
# Numbered sequentially, no gaps: GEMINI_API_KEY_2, GEMINI_API_KEY_3, ...
# GEMINI_API_KEY_2=your-second-gemini-key-here
GROQ_API_KEY=gsk_your-key-here

# Optional — Phase 6 "Email me this plan". If unset, the itinerary is still
# generated and saved locally; email sending is just skipped gracefully.
# n8n is tried first if set (Production URL, i.e. "/webhook/...", not
# "/webhook-test/..."); SMTP below is the fallback either way.
# N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/send-itinerary
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@example.com
